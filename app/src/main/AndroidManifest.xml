<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <application
        android:name=".App"
        android:allowBackup="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.ToolKit">
        <activity
            android:name=".MainActivity"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />

                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <activity android:name="com.java.utils.ToastTestActivity" />
        <activity android:name="com.java.utils.TimeTestActivity" />
        <activity android:name="com.java.utils.ScreenTestActivity" />
        <activity android:name="com.java.utils.ViewTestActivity" />
        <activity android:name="com.java.utils.BitmapTestActivity" />
        <activity android:name="com.java.utils.ConvertTestActivity" />
        <activity android:name="com.java.utils.NetworkTestActivity" />
        <activity android:name="com.java.utils.ResourceTestActivity" />
        <activity android:name="com.java.utils.FileTestActivity" />
        <activity android:name="com.java.utils.GsonTestActivity" />
        <activity android:name="com.java.utils.LoggerTestActivity" />
        <activity android:name="com.java.utils.ThreadTestActivity" />
    </application>

</manifest>